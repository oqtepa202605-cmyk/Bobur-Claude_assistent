# Local development and testing settings.
# Create your own copy:   cp .env.example .env && chmod 600 .env
# (Windows PowerShell:    Copy-Item .env.example .env)
# On Railway this file is NOT used: set Variables with the same names instead.
# Comments must stay on their own lines (python-dotenv misreads "KEY=  # comment").

# Telegram bot token from @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (ask @userinfobot). Only this account is served.
OWNER_ID=

# false = PREVIEW mode: replies are only written to the logs, nothing is sent.
# true  = replies are sent to people from your account.
AUTO_SEND=false

# Claude subscription token: the output of `claude setup-token` (starts with sk-ant-oat...).
# Create it once on a computer with a browser; it is valid for 1 year.
# Treat it like a password. Paste it with a text editor on ONE line (not with echo,
# which would leave it in your shell history).
# Left empty: this machine's own `claude` login is used (local testing only).
# An Anthropic API key (sk-ant-api...) is rejected on purpose.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = found on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Claude model alias or full name (e.g. sonnet, opus). Empty = the CLI default.
CLAUDE_MODEL=

# Effort level: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up.
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to wait after a usage-limit error when the CLI gives no reset time.
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays silent there for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# How many recent messages per chat are kept and sent to Claude.
HISTORY_LIMIT=30
